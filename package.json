{
  "name": "@ntcore-ts/monorepo",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "test": "turbo run test --filter=@ntcore-ts/client --filter=@ntcore-ts/react --filter=@ntcore-ts/mcp",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "turbo run bench --filter=@ntcore-ts/client --filter=@ntcore-ts/react",
    "bench:ci": "tsx tools/scripts/run-bench-ci.mts",
    "e2e:local": "turbo run e2e:local --filter=@ntcore-ts/example-client",
    "docs": "turbo run docs --filter=@ntcore-ts/docs",
    "docs:dev": "npm run docs:dev -w @ntcore-ts/docs",
    "release": "npm run release:client && npm run release:react && npm run release:mcp",
    "release:client": "cd packages/client && npx -p semantic-release@25 -p semantic-release-monorepo@8 -p @semantic-release/changelog -p @semantic-release/exec -p @semantic-release/git -p @semantic-release/github -p @semantic-release/npm -- semantic-release -e semantic-release-monorepo -c ../../release.config.client.mts",
    "release:react": "cd packages/react && npx -p semantic-release@25 -p semantic-release-monorepo@8 -p @semantic-release/changelog -p @semantic-release/exec -p @semantic-release/git -p @semantic-release/github -p @semantic-release/npm -- semantic-release -e semantic-release-monorepo -c ../../release.config.react.mts",
    "release:mcp": "cd packages/mcp && npx -p semantic-release@25 -p semantic-release-monorepo@8 -p @semantic-release/changelog -p @semantic-release/exec -p @semantic-release/git -p @semantic-release/github -p @semantic-release/npm -- semantic-release -e semantic-release-monorepo -c ../../release.config.mcp.mts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@msgpack/msgpack": "^3.1.3",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "isomorphic-ws": "^5.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "protobufjs": "^8.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.63.2",
    "sass": "^1.104.1",
    "ts-proto": "^2.12.3",
    "tslib": "^2.8.1",
    "tslog": "^5.2.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitepress": "^1.6.4",
    "vitest": "5.0.1",
    "vitest-websocket-mock": "^0.8.0",
    "ws": "^8.21.3",
    "zod": "^4.6.2"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "packageManager": "npm@12.0.2"
}
