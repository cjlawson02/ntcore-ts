{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "es5",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "coverage",
    "package-lock.json",
    "notes",
    "apps/docs/api",
    "apps/docs/.vitepress/dist",
    "apps/docs/.vitepress/cache",
    ".turbo",
    "apps/example-robot/build",
    "apps/example-robot/.gradle",
    "**/src/generated",
    ".nx",
    "apps/example-robot/simgui.json",
    "apps/example-robot/simgui-ds.json",
    "apps/example-robot/simgui-window.json"
  ]
}
