{
  "name": "@ntcore-ts/mcp",
  "version": "1.0.0-beta.2",
  "description": "Model Context Protocol server for NetworkTables, built on @ntcore-ts/client",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/cjlawson02/ntcore-ts.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "ntcore-ts-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "build": "rm -rf dist && rollup -c rollup.config.mts",
    "test": "vitest run",
    "lint": "eslint .",
    "start": "tsx src/cli.ts",
    "serve": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@ntcore-ts/client": "^1.0.0-beta.2",
    "zod": "^4.6.4"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.esm.js",
    "module": "./dist/index.esm.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "ntcore-ts-mcp": "./dist/cli.js"
    },
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": "./dist/index.esm.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "keywords": [
    "ntcore",
    "networktables",
    "mcp",
    "model context protocol",
    "frc",
    "robot",
    "robotics",
    "wpilib"
  ]
}
