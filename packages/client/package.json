{
  "name": "@ntcore-ts/client",
  "version": "1.1.0",
  "description": "TypeScript client for WPILib NetworkTables 4.1 protocol",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjlawson02/ntcore-ts.git",
    "directory": "packages/client"
  },
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "build": "rm -rf dist && rollup -c rollup.config.mts",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "isomorphic-ws": "^5.0.0",
    "protobufjs": "^8.8.0",
    "tslog": "^5.2.0",
    "wpilib-struct": "^1.0.1",
    "zod": "^4.6.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ntcore",
    "networktables",
    "frc",
    "robot",
    "robotics",
    "first",
    "first robotics",
    "first robotics competition",
    "wpilib",
    "nt",
    "network",
    "tables"
  ]
}
