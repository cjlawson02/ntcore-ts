{
  "name": "@ntcore-ts/react",
  "version": "1.0.0-beta.1",
  "description": "React bindings for @ntcore-ts/client (NetworkTables for FRC)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/cjlawson02/ntcore-ts.git",
    "directory": "packages/react"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "build": "rm -rf dist && rollup -c rollup.config.mts",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@ntcore-ts/client": ">=1.0.0-0",
    "zod": ">=4.0.0"
  },
  "devDependencies": {
    "@ntcore-ts/client": "*"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.esm.js",
    "module": "./dist/index.esm.js",
    "types": "./dist/index.d.ts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "import": "./dist/index.esm.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "keywords": [
    "ntcore",
    "networktables",
    "frc",
    "robot",
    "robotics",
    "react",
    "hooks"
  ]
}
