{
  "name": "@ntcore-ts/example-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate-types": "protoc --plugin=../../node_modules/.bin/protoc-gen-ts_proto --proto_path=src --ts_proto_out=src/generated --ts_proto_opt=esModuleInterop=true,outputServices=generic-definitions,useExactTypes=false customproto.proto",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "start": "tsx src/main.ts",
    "serve": "tsx src/main.ts",
    "lint": "eslint .",
    "e2e": "vitest run --config vitest.e2e.config.mts",
    "e2e:local": "bash ../../tools/scripts/e2e-with-robot.sh"
  },
  "dependencies": {
    "@ntcore-ts/client": "*",
    "@ntcore-ts/mcp": "^1.0.0-beta.2"
  }
}
